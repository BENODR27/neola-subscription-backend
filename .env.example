NODE_ENV=development
PORT=7020
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
CONTROL_DB_NAME=neola_subscriptions
DB_SSL=false
CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:4300,http://localhost:4300
# Generate independently: openssl rand -hex 32
CONTROL_ENCRYPTION_KEY=
# Only approved instance origins can be contacted by the management bridge.
CONTROL_ERP_ALLOWED_ORIGINS=http://127.0.0.1:7001,http://localhost:7001
CONTROL_OWNER_USERNAME=
CONTROL_OWNER_PASSWORD=
CONTROL_OWNER_NAME=NeoLA Platform Owner
CONTROL_ENFORCED_APPLICATIONS=MMMS
CONTROL_ALLOW_HTTP_ERP=false
CONTROL_PORTAL_URL=http://127.0.0.1:4300
# Production defaults require both; omit these overrides unless deliberately configuring a deployment.
# CONTROL_REQUIRE_OPERATOR_MFA=true
# CONTROL_REQUIRE_VERIFIED_EMAIL=true
CONTROL_TRUST_PROXY_HOPS=0
# Production delivery adapter; queued messages are sent only by the explicit delivery worker.
CONTROL_MAIL_WEBHOOK_URL=
CONTROL_MAIL_WEBHOOK_TOKEN=
# Provider-only signing configuration; private key must never be distributed to customers.
CONTROL_LICENSE_PRIVATE_KEY_FILE=
CONTROL_REQUIRE_SIGNED_LICENSE=false
