# Provider-server .env.container. Example IPs must be replaced with actual hosts.
NODE_ENV=production
PORT=7020
HOST=0.0.0.0
DB_HOST=192.0.2.10
DB_PORT=5432
DB_USER=
DB_PASSWORD=
CONTROL_DB_NAME=neola_subscriptions
DB_SSL=false
CONTROL_ENCRYPTION_KEY=
CONTROL_TRUST_PROXY_HOPS=2
CONTROL_PORTAL_URL=https://192.0.2.10:5443
CONTROL_ALLOWED_ORIGINS=https://192.0.2.10:5443
# Allow the customer's HTTPS gateway only if using catalog/support bridge calls.
CONTROL_ERP_ALLOWED_ORIGINS=https://192.0.2.20:5443
CONTROL_ENFORCED_APPLICATIONS=MMMS,MASTERS
CONTROL_ALLOW_HTTP_ERP=false
CONTROL_REQUIRE_OPERATOR_MFA=true
CONTROL_REQUIRE_VERIFIED_EMAIL=true
