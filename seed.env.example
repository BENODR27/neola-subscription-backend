# Copy to .env.seed. Values are literal/unquoted. No default passwords are supplied.
CONTROL_OWNER_USERNAME=platform.owner
CONTROL_OWNER_NAME=NeoLA Platform Owner
CONTROL_OWNER_PASSWORD=
# Local testing only: set true to create the two optional accounts below.
CONTROL_SEED_TEST_USERS=false
CONTROL_APPROVER_USERNAME=local.approver
CONTROL_APPROVER_PASSWORD=
CONTROL_CUSTOMER_USERNAME=local.customer
CONTROL_CUSTOMER_PASSWORD=
CONTROL_CUSTOMER_NAME=Local Test Customer
CONTROL_CUSTOMER_EMAIL=customer@example.invalid
